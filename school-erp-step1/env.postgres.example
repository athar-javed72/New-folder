# Copy these lines into .env (replace the sqlite defaults of a fresh Laravel 12 project)
APP_NAME="School ERP"
APP_TIMEZONE=Asia/Karachi

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=school_erp
DB_USERNAME=school_erp
DB_PASSWORD=change_me
DB_SCHEMA=public
DB_SSLMODE=prefer

# Phase 0 can stay on database drivers; move to redis when Horizon is added
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
